# The hub's settings (docs/hub.md has them all). Copy to hub.env.
LICASH_HUB_NAME=my-hub
LICASH_HUB_NETWORK=mutinynet
# Its node, on the host (cookie or user:pass), and the Core wallet that
# funds its contracts' fees and collateral.
LICASH_HUB_CHAIN=http://licash:PASSWORD@host.docker.internal:38332
LICASH_HUB_CONTRACTS=true
LICASH_HUB_CONTRACTS_WALLET=http://licash:PASSWORD@host.docker.internal:38332/wallet/licash-hub
# Its witnesses: the set, and each member with its TLS pin.
LICASH_HUB_CONTRACTS_WITNESS_SET=SET_ID
LICASH_HUB_CONTRACTS_WITNESS=https://witness-1.example:8339#PIN1,https://witness-2.example:8339#PIN2
# What it lends of a contract, and of all of them (0: holders fund their
# part).
LICASH_HUB_CONTRACTS_LEND=0
LICASH_HUB_CONTRACTS_LEND_TOTAL=0
# How much more than its own machine proves, rented machines included
# (docs/r0.md): set by the operator, low by default.
LICASH_HUB_CONTRACTS_PROOF_SCALE=1.0
# Rented GPUs that prove segments beside the local one, over SSH (keys in
# <data>/.ssh). Empty: the local GPU alone.
LICASH_R0_WORKERS=
LICASH_HUB_ONION=true
LICASH_HUB_NOTIFY=ntfys://ntfy.sh/CHANGE-ME
