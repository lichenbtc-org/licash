# The standby's settings: the hub's network, chain and witnesses, its own
# node and fee wallet. Copy to standby.env.
LICASH_HUB_NAME=my-hub-standby
LICASH_HUB_NETWORK=mutinynet
LICASH_HUB_CHAIN=http://licash:PASSWORD@host.docker.internal:38332
LICASH_HUB_CONTRACTS=true
# Its own Core wallet, funded for the fees of its answers: never the hub's.
LICASH_HUB_CONTRACTS_WALLET=http://licash:PASSWORD@host.docker.internal:38332/wallet/licash-standby
LICASH_HUB_CONTRACTS_WITNESS_SET=SET_ID
LICASH_HUB_CONTRACTS_WITNESS=https://witness-1.example:8339#PIN1,https://witness-2.example:8339#PIN2
# It has no GPU: rented ones prove for it, over SSH (keys in
# /srv/licash-standby/data/.ssh), once it must (docs/deploy.md).
LICASH_R0_WORKERS=
LICASH_HUB_NOTIFY=ntfys://ntfy.sh/CHANGE-ME
